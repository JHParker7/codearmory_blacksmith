# Design/plan documents are kept out of version control, matching the convention
# in the codearmory monorepo: these are working documents, not published ones.
# Remove this line deliberately if blacksmith is private and you want them tracked.
plans/

# Go
*.test
/blacksmith

# Local operator state — keys, model symlinks, transcripts
*.key

# Scratch checkouts the agents build into, and the leftover python virtualenv.
# Neither is source; both are local to a workstation.
/test_repo/
/venv/

# session scratch (e2e runs, service logs, deploy helpers)
.e2e*
.serve*.log
.ca-build.log
workshop/
build-ca-images.sh
dns-fix.service
