{
  "name": "plan-arm",
  "description": "The plan arm as a CodeArmory workflow: a shared forge volume holds the checkout, blacksmith ACTIONS run the agent roles against it, and forge/run STEPS do the deterministic work (checks, scanners, version, image build, push) between them. Blacksmith owns the roles; forge owns the volume, execution and git; this workflow owns the flow. Trigger with inputs {repo, ref, task}.",
  "inputs": { "repo": "", "ref": "", "task": "" },

  "steps": [
    { "name": "workspace", "action": "forge/create-volume",
      "with": { "workflow_id": "${run_id}", "name": "ws", "medium": "memory" } },

    { "name": "clone", "action": "forge/run",
      "with": { "run": "git clone ${inputs.repo} /work && cd /work && git checkout ${inputs.ref}",
                "volumes": [ { "workflow_id": "${run_id}", "name": "ws", "mount_path": "/work", "workdir": true } ] } },

    { "name": "architect", "action": "blacksmith/agent",
      "with": { "role": "plan-architect", "workflow_id": "${run_id}", "volume": "ws", "task": "${inputs.task}" } },

    { "name": "tests", "action": "blacksmith/agent",
      "with": { "role": "plan-test", "workflow_id": "${run_id}", "volume": "ws", "task": "${inputs.task}" } },

    { "name": "expected-red", "action": "forge/run",
      "with": { "run": "cd /work && go build -o /tmp/gobin/ ./... && go vet ./... && ! go test ./...",
                "volumes": [ { "workflow_id": "${run_id}", "name": "ws", "mount_path": "/work", "workdir": true } ] } },

    { "name": "dev", "action": "blacksmith/agent",
      "with": { "role": "plan-dev", "workflow_id": "${run_id}", "volume": "ws", "task": "${inputs.task}" } },

    { "name": "green", "action": "forge/run",
      "with": { "run": "cd /work && go build -o /tmp/gobin/ ./... && go test ./...",
                "volumes": [ { "workflow_id": "${run_id}", "name": "ws", "mount_path": "/work", "workdir": true } ] } },

    { "name": "sast", "action": "forge/run",
      "with": { "run": "cd /work && mkdir -p scan && (gosec -quiet ./... > scan/sast.txt 2>&1 || true)",
                "volumes": [ { "workflow_id": "${run_id}", "name": "ws", "mount_path": "/work", "workdir": true } ] } },
    { "name": "sca", "action": "forge/run",
      "with": { "run": "cd /work && (govulncheck ./... > scan/sca.txt 2>&1 || true)",
                "volumes": [ { "workflow_id": "${run_id}", "name": "ws", "mount_path": "/work", "workdir": true } ] } },

    { "name": "sec-review", "action": "blacksmith/agent",
      "with": { "role": "plan-sec", "workflow_id": "${run_id}", "volume": "ws", "task": "${inputs.task}" } },

    { "name": "lint", "action": "forge/run",
      "with": { "run": "cd /work && (staticcheck ./... > scan/lint.txt 2>&1 || true)",
                "volumes": [ { "workflow_id": "${run_id}", "name": "ws", "mount_path": "/work", "workdir": true } ] } },

    { "name": "quality-review", "action": "blacksmith/agent",
      "with": { "role": "plan-review", "workflow_id": "${run_id}", "volume": "ws", "task": "${inputs.task}" } },

    { "name": "version", "action": "forge/run",
      "with": { "run": "cd /work && git tag $(scripts/semver.sh) || true; git describe --tags --abbrev=0 --match 'v*'",
                "volumes": [ { "workflow_id": "${run_id}", "name": "ws", "mount_path": "/work", "workdir": true } ],
                "output_env": [ "VERSION" ] } },

    { "name": "package", "action": "forge/run",
      "with": { "run": "cd /work && docker build -t ${CONTAINERS_URL}/${inputs.repo}:${steps.version.output.VERSION} . && docker push ${CONTAINERS_URL}/${inputs.repo}:${steps.version.output.VERSION}",
                "volumes": [ { "workflow_id": "${run_id}", "name": "ws", "mount_path": "/work", "workdir": true } ] } },

    { "name": "push", "action": "forge/run",
      "with": { "run": "cd /work && git add -A && git -c user.name=blacksmith -c user.email=blacksmith@codearmory commit -m 'chore: run ${run_id}' && git push origin HEAD:refs/heads/${inputs.ref}",
                "volumes": [ { "workflow_id": "${run_id}", "name": "ws", "mount_path": "/work", "workdir": true } ] } }
  ],

  "routes": [
    { "from": "expected-red",   "to": "dev",  "when": "steps.expected-red.status == 'completed'" },
    { "from": "green",          "to": "sast", "when": "steps.green.status == 'completed'" },
    { "from": "green",          "to": "dev",  "when": "steps.green.status == 'failed'" }
  ]
}
