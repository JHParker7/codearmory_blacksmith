[
  {
    "name": "blacksmith",
    "url": "http://blacksmith:8199",
    "description": "Agent harness: ONE general agent action the workflows engine invokes, configured by a ROLE picked with a variable. Roles (prompt, read/write guards, tools, check, budgets) are editable data stored in postgres and managed in the portal. Blacksmith owns the harness; forge owns the volume, clone, exec and push; the workflow owns the flow. Each run acts as a temp identity scoped to the triggering user.",
    "forward_auth": true,
    "service_key": "blacksmith-registry-local-secret",

    "endpoints": [
      { "method": "POST",   "path": "/actions/agent",  "action": "runAction",  "resource": "blacksmith/actions" },
      { "method": "GET",    "path": "/actions/{id}",   "action": "pollAction", "resource": "blacksmith/actions" },

      { "method": "GET",    "path": "/roles",          "action": "listRole",   "resource": "blacksmith/roles" },
      { "method": "GET",    "path": "/roles/{name}",   "action": "getRole",    "resource": "blacksmith/roles" },
      { "method": "PUT",    "path": "/roles/{name}",   "action": "updateRole", "resource": "blacksmith/roles" },
      { "method": "DELETE", "path": "/roles/{name}",   "action": "deleteRole", "resource": "blacksmith/roles" }
    ],

    "actions": [
      { "name": "blacksmith/agent", "summary": "Run one configured agent role against the shared volume; the role names the prompt, guards, tools and check", "method": "POST", "path": "/actions/agent", "required_permission": { "action": "runAction", "resource": "blacksmith/actions" }, "async": { "id_field": "job_id", "poll_path": "/actions/{id}", "poll_interval_secs": 5, "status_field": "status", "success_states": ["completed"], "failure_states": ["failed"], "output_map_field": "outputs", "output_field": "stdout", "error_fields": ["error"] } }
    ],

    "default_grants": [
      {
        "grant_on": "user",
        "actions": ["runAction", "pollAction"],
        "resources": ["{username}/blacksmith/actions"]
      },
      {
        "grant_on": "user",
        "actions": ["listRole", "getRole", "updateRole", "deleteRole"],
        "resources": ["{username}/blacksmith/roles"]
      }
    ]
  }
]
