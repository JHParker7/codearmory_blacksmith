{
  "name": "autofix-queue",
  "project": "agentic-dev-flow",
  "timeout_secs": 7200,
  "description": "Single-agent work-queue autofix. Seeds one ticket per finding, then ONE queue-fixer agent works them one at a time via the next_task tool (fix -> next_task marks it done and hands back the next) in a single warm session \u2014 one clone, one sandbox, one model context for all findings. The queue (the board) drives coverage, so nothing is skipped. Then publish. Inputs {namespace, repo, ref, project, findings, number?}.",
  "inputs": [
    {
      "name": "namespace",
      "type": "string",
      "required": true
    },
    {
      "name": "repo",
      "type": "string",
      "required": true
    },
    {
      "name": "ref",
      "type": "string",
      "required": true
    },
    {
      "name": "project",
      "type": "string",
      "required": true
    },
    {
      "name": "findings",
      "type": "string",
      "required": true
    },
    {
      "name": "number",
      "type": "string",
      "required": false
    }
  ],
  "steps": [
    {
      "name": "workspace",
      "action": "forge/create-volume",
      "timeout": 60,
      "with": {
        "workflow_id": "${run_id}",
        "name": "ws",
        "medium": "memory"
      }
    },
    {
      "name": "gocache",
      "action": "forge/create-volume",
      "timeout": 60,
      "with": {
        "workflow_id": "${run_id}",
        "name": "gocache",
        "size_mb": 8192,
        "medium": "disk"
      }
    },
    {
      "name": "clone",
      "action": "forge/run",
      "timeout": 300,
      "with": {
        "image": "golang:1.25",
        "runner_class": "large",
        "run": "set -e; export HOME=/tmp GOCACHE=/tmp/gocache GOPATH=/tmp/go; git config --global --add safe.directory '*'; git clone -q \"$GIT_URL\" /workspace; cd /workspace; git checkout -q \"${inputs.ref}\"; git rev-parse HEAD > /workspace/.fixbase; echo \"working on branch ${inputs.ref}:\"; git log --oneline -1",
        "volumes": [
          {
            "workflow_id": "${run_id}",
            "name": "ws",
            "mount_path": "/workspace",
            "workdir": true
          }
        ],
        "secret_refs": {
          "GIT_URL": "git:http://codearmory-git-factory:9002/${inputs.namespace}/${inputs.repo}.git"
        }
      }
    },
    {
      "name": "seed",
      "action": "blacksmith/agent",
      "timeout": 900,
      "with": {
        "role": "board-seed",
        "workflow_id": "${run_id}",
        "volume": "ws",
        "project": "${inputs.project}",
        "task": "Seed the review board with these findings, one ticket each (status todo):\n\n${inputs.findings}"
      },
      "permissions": [
        {
          "service": "forge",
          "action": "createLease",
          "resource": "forge/leases"
        },
        {
          "service": "forge",
          "action": "getLease",
          "resource": "forge/leases"
        },
        {
          "service": "forge",
          "action": "deleteLease",
          "resource": "forge/leases"
        },
        {
          "service": "forge",
          "action": "createExecution",
          "resource": "forge/executions"
        },
        {
          "service": "forge",
          "action": "getExecution",
          "resource": "forge/executions/*"
        },
        {
          "service": "tickets",
          "action": "createTicket",
          "resource": "tickets/tickets"
        },
        {
          "service": "tickets",
          "action": "listTicket",
          "resource": "tickets/tickets"
        },
        {
          "service": "tickets",
          "action": "getTicket",
          "resource": "tickets/tickets/*"
        },
        {
          "service": "tickets",
          "action": "updateTicket",
          "resource": "tickets/tickets/*"
        },
        {
          "service": "tickets",
          "action": "createComment",
          "resource": "tickets/tickets/*"
        }
      ]
    },
    {
      "name": "fix",
      "action": "blacksmith/agent",
      "timeout": 3000,
      "with": {
        "role": "queue-fixer",
        "workflow_id": "${run_id}",
        "volume": "ws",
        "project": "${inputs.project}",
        "task": "Fix every finding on the board, one at a time, using the next_task tool. Call next_task to get your first finding; fix it; call next_task again for the next; repeat until it says there are no more.",
        "cache_workflow_id": "${run_id}",
        "cache_volume": "gocache"
      },
      "permissions": [
        {
          "service": "forge",
          "action": "createLease",
          "resource": "forge/leases"
        },
        {
          "service": "forge",
          "action": "getLease",
          "resource": "forge/leases"
        },
        {
          "service": "forge",
          "action": "deleteLease",
          "resource": "forge/leases"
        },
        {
          "service": "forge",
          "action": "createExecution",
          "resource": "forge/executions"
        },
        {
          "service": "forge",
          "action": "getExecution",
          "resource": "forge/executions/*"
        },
        {
          "service": "tickets",
          "action": "createTicket",
          "resource": "tickets/tickets"
        },
        {
          "service": "tickets",
          "action": "listTicket",
          "resource": "tickets/tickets"
        },
        {
          "service": "tickets",
          "action": "getTicket",
          "resource": "tickets/tickets/*"
        },
        {
          "service": "tickets",
          "action": "updateTicket",
          "resource": "tickets/tickets/*"
        },
        {
          "service": "tickets",
          "action": "createComment",
          "resource": "tickets/tickets/*"
        }
      ]
    },
    {
      "name": "show",
      "action": "forge/run",
      "timeout": 120,
      "with": {
        "image": "golang:1.25",
        "runner_class": "large",
        "run": "set +e; export HOME=/tmp; git config --global --add safe.directory '*'; cd /workspace; echo '=== diffstat vs base ==='; BASE=$(cat /workspace/.fixbase 2>/dev/null); git diff --stat \"$BASE\" HEAD 2>/dev/null | tail -20; echo done",
        "volumes": [
          {
            "workflow_id": "${run_id}",
            "name": "ws",
            "mount_path": "/workspace",
            "workdir": true
          }
        ]
      }
    },
    {
      "name": "publish",
      "action": "forge/run",
      "timeout": 200,
      "with": {
        "image": "golang:1.25",
        "runner_class": "large",
        "run": "set -e; export HOME=/tmp; git config --global --add safe.directory '*'; cd /workspace; REF='${inputs.ref}'; git rm -q -r --ignore-unmatch .review .board AUDIT.md STRENGTH.md >/dev/null 2>&1 || true; git -c user.email=publish@forge.cicd -c user.name=publish commit -q -am 'chore: drop review artifacts' >/dev/null 2>&1 || true; BASE=$(git rev-parse \"origin/$REF\"); if [ \"$(git rev-parse HEAD)\" = \"$BASE\" ]; then echo 'no fix commits -- nothing to push'; fixed=0; export fixed; echo \"fixed=$fixed\"; exit 0; fi; git push \"$GIT_URL\" HEAD:refs/heads/$REF; echo \"pushed the fix to $REF\"; fixed=1; export fixed; echo \"fixed=$fixed\"",
        "volumes": [
          {
            "workflow_id": "${run_id}",
            "name": "ws",
            "mount_path": "/workspace",
            "workdir": true
          }
        ],
        "secret_refs": {
          "GIT_URL": "git:http://codearmory-git-factory:9002/${inputs.namespace}/${inputs.repo}.git"
        },
        "output_env": [
          "fixed"
        ]
      }
    }
  ],
  "outputs": [
    {
      "name": "fixed",
      "value": "${steps.publish.output.fixed}"
    }
  ]
}
