{
  "name": "agent-chain",
  "project": "agentic-dev-flow",
  "description": "Request-triggered orchestrator (corrected end-to-end): the architect writes the design to the project WIKI (wiki_page); the PM reads the wiki (wiki_read) and files one task ticket per task in the tickets service (file_ticket); then the build pipeline is invoked, and its test-writer + developer read the PM's tickets (read_tickets) and the wiki, write the code test-first, and open a PR to dev on git-factory. The opened PR auto-reviews (pr-review-on-open) and on merge auto-builds the image (build-dev). Rebuilt 2026-09-13 to the request->architect->pm->build-pipeline flow.",
  "timeout_secs": 7200,
  "inputs": [
    {
      "name": "task",
      "required": true,
      "description": "the request the department builds"
    },
    {
      "name": "repo",
      "required": true,
      "description": "the git-factory repo the build pipeline creates/extends and opens a dev PR to"
    },
    {
      "name": "project",
      "required": true,
      "description": "the project this run and every resource it creates (wiki pages, tickets, repo, PR) belong to"
    },
    {
      "name": "namespace",
      "required": true,
      "description": "the git-factory namespace (owner) the repo lives under"
    }
  ],
  "steps": [
    {
      "action": "forge/create-volume",
      "name": "workspace",
      "timeout": 120,
      "with": {
        "workflow_id": "${run_id}",
        "name": "ws",
        "medium": "memory"
      }
    },
    {
      "action": "tickets/create",
      "name": "epic",
      "timeout": 60,
      "with": {
        "title": "${inputs.task}",
        "description": "Delivery epic — tracks this request across the lifecycle board (repo=${inputs.repo}). Auto-managed by agent-chain.",
        "project": "${inputs.project}",
        "board_id": "020503fd-8684-452e-9987-c908c5ad651e",
        "status": "todo",
        "workflow_id": "${run_id}"
      }
    },
    {
      "action": "blacksmith/agent",
      "name": "architect",
      "timeout": 3000,
      "with": {
        "role": "architect",
        "workflow_id": "${run_id}",
        "volume": "ws",
        "project": "${inputs.project}",
        "task": "${inputs.task}"
      },
      "permissions": [
        {
          "service": "forge",
          "action": "createLease",
          "resource": "forge/leases"
        },
        {
          "service": "forge",
          "action": "getLease",
          "resource": "forge/leases"
        },
        {
          "service": "forge",
          "action": "deleteLease",
          "resource": "forge/leases"
        },
        {
          "service": "forge",
          "action": "createExecution",
          "resource": "forge/executions"
        },
        {
          "service": "forge",
          "action": "getExecution",
          "resource": "forge/executions/*"
        },
        {
          "service": "wiki",
          "action": "writePage",
          "resource": "project/*/wiki/pages/*"
        },
        {
          "service": "wiki",
          "action": "getPage",
          "resource": "project/*/wiki/pages/*"
        },
        {
          "service": "wiki",
          "action": "listPage",
          "resource": "project/*/wiki/pages"
        }
      ]
    },
    {
      "action": "tickets/update",
      "name": "epic_plan",
      "timeout": 60,
      "with": {
        "id": "${steps.epic.output.ticket_id}",
        "status": "plan"
      }
    },
    {
      "action": "blacksmith/agent",
      "name": "pm",
      "timeout": 2400,
      "with": {
        "role": "pm",
        "workflow_id": "${run_id}",
        "volume": "ws",
        "project": "${inputs.project}",
        "task": "${inputs.task}"
      },
      "permissions": [
        {
          "service": "forge",
          "action": "createLease",
          "resource": "forge/leases"
        },
        {
          "service": "forge",
          "action": "getLease",
          "resource": "forge/leases"
        },
        {
          "service": "forge",
          "action": "deleteLease",
          "resource": "forge/leases"
        },
        {
          "service": "forge",
          "action": "createExecution",
          "resource": "forge/executions"
        },
        {
          "service": "forge",
          "action": "getExecution",
          "resource": "forge/executions/*"
        },
        {
          "service": "wiki",
          "action": "getPage",
          "resource": "project/*/wiki/pages/*"
        },
        {
          "service": "wiki",
          "action": "listPage",
          "resource": "project/*/wiki/pages"
        },
        {
          "service": "tickets",
          "action": "createTicket",
          "resource": "tickets/tickets"
        },
        {
          "service": "tickets",
          "action": "listTicket",
          "resource": "tickets/tickets"
        },
        {
          "service": "tickets",
          "action": "getTicket",
          "resource": "tickets/tickets/*"
        }
      ]
    },
    {
      "action": "tickets/update",
      "name": "epic_triage",
      "timeout": 60,
      "with": {
        "id": "${steps.epic.output.ticket_id}",
        "status": "triage"
      }
    },
    {
      "action": "tickets/update",
      "name": "epic_inprogress",
      "timeout": 60,
      "with": {
        "id": "${steps.epic.output.ticket_id}",
        "status": "in_progress"
      }
    },
    {
      "action": "workflows/trigger",
      "name": "build",
      "timeout": 3600,
      "with": {
        "pipeline": "2d0b1f4c-e232-4ed7-9918-227dd2f3be04",
        "inputs": {
          "task": "${inputs.task}",
          "namespace": "${inputs.namespace}",
          "repo": "${inputs.repo}",
          "project": "${inputs.project}"
        }
      }
    }
  ],
  "outputs": [
    {
      "name": "build_run",
      "value": "${steps.build.output.run_id}"
    },
    {
      "name": "epic_ticket",
      "value": "${steps.epic.output.ticket_id}"
    }
  ]
}
